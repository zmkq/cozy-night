# Upstash Redis / Vercel KV REST API Credentials (Required for prompt loading/saving)
KV_REST_API_URL="https://your-upstash-instance-name.upstash.io"
KV_REST_API_TOKEN="your_upstash_rest_token_here"

# Iron-Session Encryption Key (Required, must be at least 32 characters long)
SESSION_SECRET="complex_password_at_least_32_characters_long"

# PartyKit Host (Optional, defaults to 127.0.0.1:1999 in local development mode)
NEXT_PUBLIC_PARTYKIT_HOST="your-party-name.username.partykit.dev"
